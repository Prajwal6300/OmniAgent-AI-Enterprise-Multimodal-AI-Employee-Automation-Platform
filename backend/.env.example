# Backend Environment Variables
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="OmniAgent AI"
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omniagent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omniagent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET=super-secret-jwt-key-omniagent-ai-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO / S3
STORAGE_PROVIDER=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=omniagent-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o
