# Local development: frontend talks to host backend via Vite proxy
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Docker / production: frontend talks to backend via nginx reverse proxy
VITE_API_BASE_URL_DOCKER=/api/v1

# Vite only reads VITE_* variables; the client code uses the fallback:
#   import.meta.env.VITE_API_BASE_URL || '/api/v1'
# Set VITE_API_BASE_URL in your local .env for dev mode.
# Docker compose overrides VITE_API_BASE_URL at runtime.
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_NAME="OmniAgent AI"
