# ==============================================================================
# OmniAgent AI — Master Environment Configuration Example
# Copy this file to .env and provide your deployment secrets.
# NEVER COMMIT REAL SECRET VALUES OR KEYS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server
# ------------------------------------------------------------------------------
# Where to set: Render environment variables / local .env
# Values: development | production | staging | test
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="OmniAgent AI"
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets (MUST be unique, random, >= 32 characters in production)
# ------------------------------------------------------------------------------
# Where to get it: Generate with `openssl rand -hex 32`
SECRET_KEY=insecure-dev-secret-key-change-in-production-min32chars
JWT_SECRET=insecure-dev-jwt-secret-change-in-production-min32chars

# Where to get it: Fernet key generated with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins (comma-separated list in env or JSON list)
# Where to get it: Your deployed Vercel frontend URL + local dev ports
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","https://omniagent.ai"]

# ------------------------------------------------------------------------------
# 3. Database (Supabase PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
# Where to get it: Supabase Project Settings -> Database -> Connection String
# - Local dev: postgresql+asyncpg://postgres:postgres@localhost:5432/omniagent_db
# - Production Supabase Transaction Pooler (port 6543): postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omniagent_db

# Where to get it: Supabase Direct Session Connection (port 5432) for Alembic migrations
ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omniagent_db

# ------------------------------------------------------------------------------
# 4. Redis (Render Key Value / Upstash / Redis 7)
# ------------------------------------------------------------------------------
# Where to get it: Render Dashboard -> New Key Value -> Internal Connection URL
# - Local dev: redis://localhost:6379/0
# - Production: rediss://default:[password]@[host].render.com:6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. LLM & Embeddings (OpenAI API Only)
# ------------------------------------------------------------------------------
# Where to get it: OpenAI Platform -> API Keys (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 6. Object Storage (Supabase Storage S3-Compatible API)
# ------------------------------------------------------------------------------
# Where to get it: Supabase Project Settings -> Storage -> S3 Access Keys
# - Local dev: STORAGE_PROVIDER=local
# - Production: STORAGE_PROVIDER=supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage/documents
MAX_UPLOAD_SIZE_BYTES=26214400

SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_BUCKET=documents

# ------------------------------------------------------------------------------
# 7. Optional Integrations (SMTP & Observability)
# ------------------------------------------------------------------------------
# Where to get it: SendGrid / Resend / Amazon SES / Mailgun
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@omniagent.ai
SMTP_USE_TLS=true

# Where to get it: Sentry -> Project Settings -> Client Keys (DSN)
SENTRY_DSN=
