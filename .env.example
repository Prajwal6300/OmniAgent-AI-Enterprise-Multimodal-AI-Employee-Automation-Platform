# ==============================================================================
# OmniAgent AI — Master Environment Configuration Example
# Copy this file to .env and configure the variables for your deployment.
# NEVER COMMIT REAL SECRETS OR SENSITIVE API KEYS TO SOURCE CONTROL.
# ==============================================================================

# --- Environment & General ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="OmniAgent AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omniagent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omniagent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Security & JWT ---
JWT_SECRET=super-secret-jwt-key-change-in-production-omniagent-ai
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Object Storage (MinIO / S3) ---
STORAGE_PROVIDER=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=omniagent-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- LLM Providers & Models ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_MODEL=gpt-4o
SUPERVISOR_MODEL=gpt-4o
VISION_MODEL=gpt-4o
REASONING_MODEL=gpt-4o

# --- Embeddings & Vector Search ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536

# --- Integrations & Tools ---
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@omniagent.ai

WEB_SEARCH_API_KEY=
TAVILY_API_KEY=

# --- Monitoring & Observability ---
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=INFO
