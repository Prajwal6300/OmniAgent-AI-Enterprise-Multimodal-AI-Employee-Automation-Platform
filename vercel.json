{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html", "statusCode": 200 }
  ],
  "headers": [
    { "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "origin-when-cross-origin" }
      ]
    }
  ]
}